// ===== COLOR HELPERS =====
function hexToLight(hex) {
  var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return 'rgb(' + Math.round(r + (255-r)*0.92) + ',' + Math.round(g + (255-g)*0.92) + ',' + Math.round(b + (255-b)*0.92) + ')';
}
function hexToMid(hex) {
  var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return 'rgb(' + Math.round(r + (255-r)*0.65) + ',' + Math.round(g + (255-g)*0.65) + ',' + Math.round(b + (255-b)*0.65) + ')';
}
function adjustBrightness(hex, amt) {
  var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  return 'rgb(' + Math.min(255,r+amt) + ',' + Math.min(255,g+amt) + ',' + Math.min(255,b+amt) + ')';
}
function darken(hex, factor) {
  var r = parseInt(hex.slice(1,3),16), g = parseInt(hex.slice(3,5),16), b = parseInt(hex.slice(5,7),16);
  var f = 1 - factor;
  return 'rgb(' + Math.round(r + (40-r)*f) + ',' + Math.round(g + (20-g)*f) + ',' + Math.round(b + (10-b)*f) + ')';
}

function formatDate(dateStr) {
  var d = new Date(dateStr);
  var months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
  var day = d.getDate();
  var suffix = day === 1 || day === 21 || day === 31 ? 'st' : day === 2 || day === 22 ? 'nd' : day === 3 || day === 23 ? 'rd' : 'th';
  return day + suffix + ' ' + months[d.getMonth()] + ', ' + d.getFullYear();
}

