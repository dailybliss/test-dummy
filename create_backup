  document.getElementById('success-overlay').classList.add('open');
  document.body.style.overflow = 'hidden';
}

// ===== PDF GENERATION (MULTI-PAGE) =====
function isMobile() {
  return /Android|iPhone|iPad|iPod|webOS|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) || window.innerWidth < 768;
}

// Storage for generated page blobs
var generatedPageCanvases = [];  // array of per-page canvases

// Renders the full biodata, slices into pages, and produces per-page canvases.
// Calls callback(pageCanvases[]) when done.
// Find clean page break points between sections.
// Returns an array of [start0, start1, start2, ..., end] pixel positions
// where we can safely slice without cutting through any text.
// Fix photo aspect-ratio in a container (html2canvas can't read CSS aspect-ratio)
function fixPhotoHeights(container) {
  var photoEls = container.querySelectorAll('.pv-photo');
  photoEls.forEach(function(photo) {
    var w = photo.offsetWidth;
    if (w > 0) {
      var ratio = photoRatioForShape(customize.photoShape);
      photo.style.height = Math.round(w * ratio) + 'px';
      photo.style.aspectRatio = 'auto';
    }
  });
}

// Build content and paginate it so no section is split across a page boundary.
// Uses physical spacer <div>s (not margins) and a verify loop that re-measures
// after every push, so it self-corrects until no section crosses a boundary.
var paginatedCache = { html: '', pageCount: 1 };

function insertSpacerBefore(el, height) {
  if (height <= 0) return;
  var prev = el.previousElementSibling;
  if (prev && prev.className === 'pv-page-spacer') {
    prev.style.height = ((parseFloat(prev.style.height) || 0) + height) + 'px';
  } else {
    var spacer = document.createElement('div');
    spacer.className = 'pv-page-spacer';
    spacer.style.cssText = 'height:' + height + 'px;flex-shrink:0;';
    el.parentNode.insertBefore(spacer, el);
  }
}

function buildPaginatedContent() {
  var mc = document.getElementById('pdf-render-container');
  mc.style.display = 'block';
  mc.style.height = 'auto';
  mc.style.overflow = 'visible';
  mc.style.transform = 'none';
  mc.innerHTML = buildPreviewHTML(false, true);

  fixPhotoHeights(mc);

  var pvContent = mc.querySelector('.pv-content');
  void pvContent.offsetHeight;

  var pageHeight = 842;

  // Position of an element relative to pv-content's top border edge.
  // pv-content is position:relative, so it is the offsetParent of every
  // static descendant — offsetTop chain is exact, no viewport/scroll involved.
  function relTop(el) {
    var t = 0;
    var node = el;
    while (node && node !== pvContent) {
      t += node.offsetTop;
      node = node.offsetParent;
    }
    return t;
  }

  if (maxPages > 1) {
    // Pagination with small safe margins. Sections avoid crossing page
    // boundaries; but a section TALLER than a page (or than the space left)
    // is allowed to split between its field rows so we don't waste space.
    var TOP_MARGIN = 12;     // small blank zone at the start of pages 2+
    var BOTTOM_MARGIN = 12;  // small blank zone at the end of every page
    var usable = pageHeight - TOP_MARGIN - BOTTOM_MARGIN;

    var safety = 0;
    var changed = true;
    while (changed && safety < 20) {
      changed = false;
      safety++;
      void pvContent.offsetHeight;

      var secs = mc.querySelectorAll('.pv-section');
      for (var i = 0; i < secs.length; i++) {
        var sec = secs[i];
        var top = relTop(sec);
        var h = sec.offsetHeight;
        var bottom = top + h;

        var page = Math.floor(top / pageHeight);
        var pageTop = page * pageHeight;
        var contentStart = pageTop + (page > 0 ? TOP_MARGIN : 0);
        var contentEnd = (page + 1) * pageHeight - BOTTOM_MARGIN;

        // Case A: section starts inside the top margin band → nudge below it
        if (top < contentStart) {
          insertSpacerBefore(sec, contentStart - top);
          changed = true;
          break;
        }

        // Section overruns the bottom margin. Rather than moving the whole
        // section to the next page (which wastes space on this page), split it
        // at a field-row boundary: keep the title + rows that fit here, and push
        // only the overflowing rows to the next page.
        if (bottom > contentEnd) {
          var rows = sec.querySelectorAll('.pv-field, .pv-sec-title, .pv-pref-text');
          var splitRow = null;
          var splitRowIdx = -1;
          for (var r = 0; r < rows.length; r++) {
            var rTop = relTop(rows[r]);
            var rBottom = rTop + rows[r].offsetHeight;
            if (rBottom > contentEnd) { splitRow = rows[r]; splitRowIdx = r; break; }
          }

          if (splitRow) {
            // How many rows fit on the current page before the split?
            // rows[0] is the section title. We need the title + at least one
            // data row to remain, otherwise the title would be orphaned —
            // in that case move the whole section to the next page instead.
            var keepsTitlePlusRow = splitRowIdx >= 2; // 0=title,1=first row → need idx>=2
            if (keepsTitlePlusRow) {
              var sTop = relTop(splitRow);
              insertSpacerBefore(splitRow, ((page + 1) * pageHeight + TOP_MARGIN) - sTop);
              changed = true;
              break;
            } else {
              // Not enough of the section fits — move the whole section down
              insertSpacerBefore(sec, ((page + 1) * pageHeight + TOP_MARGIN) - top);
              changed = true;
              break;
            }
          }
        }
      }
    }
    void pvContent.offsetHeight;
  }

  var naturalHeight = pvContent.scrollHeight;
  var pageCount = (maxPages === 1) ? 1 : Math.min(Math.ceil(naturalHeight / pageHeight), maxPages);
  if (pageCount < 1) pageCount = 1;

  paginatedCache = {
    html: mc.innerHTML,
    pageCount: pageCount,
    naturalHeight: naturalHeight
  };

  mc.innerHTML = '';
  mc.style.display = 'none';
  mc.style.height = '842px';
  mc.style.overflow = 'hidden';

  return paginatedCache;
}

function renderPhotoPageCanvas(renderScale, callback) {
  var ac = customize.accentColor;
  var bgMid = hexToMid(ac);
  var photoPageHTML = buildPhotoPageHTML(ac, bgMid);
  if (!photoPageHTML) { callback(null); return; }

  var container = document.getElementById('pdf-render-container');
  container.style.display = 'block';
  container.style.height = '842px';
  container.style.overflow = 'hidden';
  container.innerHTML = photoPageHTML;

  setTimeout(function() {
    html2canvas(container, {
      scale: renderScale, useCORS: true, allowTaint: true,
      backgroundColor: '#FFFFFF', width: 595, height: 842,
      logging: false, scrollX: 0, scrollY: 0, x: 0, y: 0
    }).then(function(canvas) {
      container.innerHTML = '';
      container.style.display = 'none';
      callback(canvas);
    }).catch(function() {
      container.innerHTML = '';
      container.style.display = 'none';
      callback(null);
    });
  }, 200);
}

function renderAllPages(callback, quiet) {
  if (!quiet) document.getElementById('generating-overlay').classList.add('open');

  var proceed = function() { renderAllPagesInner(callback, quiet); };
  if (document.fonts && document.fonts.ready) {
    document.fonts.ready.then(proceed).catch(proceed);
  } else {
    proceed();
  }
}

function renderAllPagesInner(callback, quiet) {
  if (!quiet) document.getElementById('generating-overlay').classList.add('open');

  var container = document.getElementById('pdf-render-container');
  var pageHeight = 842;
  var pageWidth = 595;

  var scrollX = window.scrollX;
  var scrollY = window.scrollY;
  var origOverflow = document.body.style.overflow;
  if (!quiet) document.body.style.overflow = 'hidden';

  // Build paginated content (sections pushed so none cross page boundaries)
  var paginated = buildPaginatedContent();
  var pageCount = paginated.pageCount;
  var naturalHeight = paginated.naturalHeight;

  container.style.display = 'block';
  container.style.height = 'auto';
  container.style.overflow = 'visible';
  container.style.transform = 'none';
  container.innerHTML = paginated.html;

  var pvContent = container.querySelector('.pv-content');
  void pvContent.offsetHeight;

  // Sizing / auto-fit
  if (maxPages === 1) {
    if (naturalHeight > pageHeight) {
      var fitScale = (pageHeight / naturalHeight) * 0.99;
      var scaledWidth = pageWidth * fitScale;
      var xOffset = (pageWidth - scaledWidth) / 2;
      pvContent.style.transformOrigin = 'top left';
      pvContent.style.transform = 'translateX(' + xOffset + 'px) scale(' + fitScale + ')';
      // Keep the background filling the full page (do NOT scale it), so the
      // template art spans edge-to-edge exactly as at full size.
      var bgEl = container.querySelector('.pv-bg');
      if (bgEl) {
        bgEl.style.width = pageWidth + 'px';
        bgEl.style.height = pageHeight + 'px';
        bgEl.style.transform = 'none';
        if (currentTemplate.bgImage) {
          bgEl.style.backgroundSize = '100% 100%';
          bgEl.style.backgroundRepeat = 'no-repeat';
        }
      }
    }
    container.style.height = pageHeight + 'px';
    container.style.overflow = 'hidden';
  } else {
    var totalHeight = pageCount * pageHeight;
    container.style.height = totalHeight + 'px';
    container.style.overflow = 'hidden';
    var bg = container.querySelector('.pv-bg');
    if (bg) {
      bg.style.height = totalHeight + 'px';
      // For image backgrounds, ensure colour doesn't bleed through
      if (currentTemplate.bgImage) {
        bg.style.backgroundColor = 'transparent';
      }
    }
  }

  var delay = quiet ? (isMobile() ? 400 : 150) : (isMobile() ? 1200 : 500);

  var cleanup = function() {
    container.innerHTML = '';
    container.style.display = 'none';
    container.style.height = '842px';
    container.style.overflow = 'hidden';
    if (!quiet) {
      document.body.style.overflow = origOverflow;
      window.scrollTo(scrollX, scrollY);
      document.getElementById('generating-overlay').classList.remove('open');
    }
  };

  var scaleAttempts = [3, 2, 1.5];

  function attemptRender(attemptIdx) {
    var renderScale = scaleAttempts[attemptIdx];
    html2canvas(container, {
      scale: renderScale,
      useCORS: true,
      allowTaint: true,
      backgroundColor: '#FFFFFF',
      width: pageWidth,
      height: pageCount * pageHeight,
      logging: false,
      scrollX: 0,
      scrollY: 0,
      x: 0,
      y: 0,
      onclone: function(clonedDoc) {
        var clonedContainer = clonedDoc.getElementById('pdf-render-container');
        if (clonedContainer) {
          var photos = clonedContainer.querySelectorAll('.pv-photo');
          photos.forEach(function(photo) {
            var w = photo.offsetWidth;
            if (w > 0) {
              var origPhoto = container.querySelector('.pv-photo');
              var h = origPhoto ? origPhoto.offsetHeight : w * 1.23;
              photo.style.height = (h || w * 1.23) + 'px';
              photo.style.aspectRatio = 'auto';
            }
            var img = photo.querySelector('img');
            if (img) { img.style.width = '100%'; img.style.height = '100%'; img.style.objectFit = 'cover'; }
          });
        }
      }
    }).then(function(fullCanvas) {
      if (!fullCanvas || fullCanvas.width === 0 || fullCanvas.height === 0) {
        throw new Error('Empty canvas at scale ' + renderScale);
      }
      try {
        // Sections were paginated to not cross boundaries — slice at clean page intervals
        var pageCanvases = [];
        var canvasScale = fullCanvas.height / (pageCount * pageHeight);
        var pageCanvasHeight = Math.round(pageHeight * canvasScale);

        for (var p = 0; p < pageCount; p++) {
          var sliceTop = Math.round(p * pageHeight * canvasScale);
          var pageCanvas = document.createElement('canvas');
          pageCanvas.width = fullCanvas.width;
          pageCanvas.height = pageCanvasHeight;
          var ctx = pageCanvas.getContext('2d');
          ctx.fillStyle = '#FFFFFF';
          ctx.fillRect(0, 0, pageCanvas.width, pageCanvas.height);
          ctx.drawImage(
            fullCanvas,
            0, sliceTop, fullCanvas.width, pageCanvasHeight,
            0, 0, pageCanvas.width, pageCanvasHeight
          );
          pageCanvases.push(pageCanvas);
        }
        generatedPageCanvases = pageCanvases;
        currentPageCount = pageCount;

        // Append photo page if enabled and has photos
        if (!hiddenSections.photopage && extraPhotos.some(function(p) { return p !== null; }) && maxPages > 1) {
          renderPhotoPageCanvas(renderScale, function(photoCanvas) {
            if (photoCanvas) generatedPageCanvases.push(photoCanvas);
            cleanup();
            if (callback) callback(generatedPageCanvases);
          });
        } else {
          cleanup();
          if (callback) callback(pageCanvases);
        }
      } catch(innerErr) {
        console.error('Slicing failed at scale ' + renderScale + ':', innerErr);
        if (attemptIdx < scaleAttempts.length - 1) attemptRender(attemptIdx + 1);
        else { cleanup(); alert('Could not create the file. Please try again.\n\nError: ' + (innerErr.message || innerErr)); }
      }
    }).catch(function(err) {
      console.error('Render failed at scale ' + renderScale + ':', err);
      if (attemptIdx < scaleAttempts.length - 1) attemptRender(attemptIdx + 1);
      else { cleanup(); alert('Failed to generate. Please try again.\n\nError: ' + (err.message || err)); }
    });
  }

  setTimeout(function() {
    try { attemptRender(0); }
    catch(outerErr) {
      console.error('Render error:', outerErr);
      cleanup();
      alert('Something went wrong. Please try again.\n\nError: ' + (outerErr.message || outerErr));
    }
  }, delay);
}

// ===== DOWNLOAD PDF (multi-page) =====
function downloadPDF() {
  renderAllPages(function(pageCanvases) {
    var jsPDF = window.jspdf.jsPDF;
    var pdf = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4', compress: true });
    pageCanvases.forEach(function(canvas, i) {
      if (i > 0) pdf.addPage();
      var imgData = canvas.toDataURL('image/jpeg', 0.95);
      pdf.addImage(imgData, 'JPEG', 0, 0, 210, 297);
    });
    var blob = pdf.output('blob');
    triggerDownload(blob, getFileName('pdf'));
    window._downloadedPDF = true;
  });
}

// ===== DOWNLOAD IMAGE (one image per page) =====
function downloadImage() {
  renderAllPages(function(pageCanvases) {
    if (pageCanvases.length === 1) {
      pageCanvases[0].toBlob(function(blob) {
        if (!blob) blob = dataURLToBlob(pageCanvases[0].toDataURL('image/png'));
        triggerDownload(blob, getFileName('png'));
        window._downloadedImage = true;
      }, 'image/png');
    } else {
      downloadImagesSequentially(pageCanvases, 0);
      window._downloadedImage = true;
    }
  });
}

function downloadImagesSequentially(canvases, idx) {
  if (idx >= canvases.length) return;
  canvases[idx].toBlob(function(blob) {
    if (!blob) blob = dataURLToBlob(canvases[idx].toDataURL('image/png'));
    var base = formData.fullName ? formData.fullName.replace(/[^a-zA-Z0-9]/g, '_') + '_biodata' : 'marriage_biodata';
    triggerDownload(blob, base + '_page' + (idx + 1) + '.png');
    // Stagger downloads so the browser doesn't block them
    setTimeout(function() {
      downloadImagesSequentially(canvases, idx + 1);
    }, 800);
  }, 'image/png');
}

function getFileName(ext) {
  var base = formData.fullName ? formData.fullName.replace(/[^a-zA-Z0-9]/g, '_') + '_biodata' : 'marriage_biodata';
  return base + '.' + ext;
}

function dataURLToBlob(dataURL) {
  var parts = dataURL.split(',');
  var mime = parts[0].match(/:(.*?);/)[1];
  var binary = atob(parts[1]);
  var array = new Uint8Array(binary.length);
  for (var i = 0; i < binary.length; i++) {
    array[i] = binary.charCodeAt(i);
  }
  return new Blob([array], { type: mime });
}

function triggerDownload(blob, filename) {
  if (!blob) {
    alert('The file is not ready yet. Please try again.');
    return;
  }
  var url = URL.createObjectURL(blob);
  var a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
  window._downloadsThisSession = (window._downloadsThisSession || 0) + 1;
}

// ===== CHECK EXISTING PAYMENT =====
function checkExistingPayment() {
  // Payment resets after every download — always require payment per download
  paymentDone = false;
}

// ===== AUTO-SAVE (debounced) =====
var saveTimer;
function autoSave() {
  clearTimeout(saveTimer);
  saveTimer = setTimeout(function() {
    readForm();
    try {
      var saveData = {
        formData: formData, siblings: siblings,
        hiddenFields: hiddenFields, hiddenSections: hiddenSections,
        customize: customize, photoData: photoData,
        incomeRangeActive: incomeRangeActive, incomeRangeValue: incomeRangeValue,
        fatherSiblings: fatherSiblings, motherSiblings: motherSiblings,
        customFields: customFields,
        customSectionTitle: document.getElementById('custom-section-title') ? document.getElementById('custom-section-title').value : ''      };
      localStorage.setItem('biodata_autosave', JSON.stringify(saveData));
    } catch(e) {}
  }, 500);
}

function loadAutoSave() {
  try {
    var saved = localStorage.getItem('biodata_autosave');
    if (!saved) return;
    var data = JSON.parse(saved);
    if (data.formData) {
      formData = data.formData;
      Object.keys(formData).forEach(function(key) {
        var input = document.querySelector('.field-input[data-field="' + key + '"]');
        if (input) input.value = formData[key] || '';
      });
    }
    // Restore income range state
    if (data.incomeRangeActive) {
      incomeRangeActive = true;
      incomeRangeValue = data.incomeRangeValue || '';
      formData.income = incomeRangeValue;
      var toggle = document.getElementById('income-range-toggle');
      if (toggle) toggle.checked = true;
      var exact = document.getElementById('income-exact');
      var range = document.getElementById('income-range');
      var from = document.getElementById('income-from');
      if (exact) exact.style.display = 'none';
      if (range) range.style.display = 'block';
      if (from) from.value = incomeRangeValue;
    }
    if (data.siblings) { siblings = data.siblings; renderSiblings(); }
    if (data.fatherSiblings) { fatherSiblings = data.fatherSiblings; renderFatherSiblingsList(); }
    if (data.motherSiblings) { motherSiblings = data.motherSiblings; renderMotherSiblingsList(); }
    if (data.customFields) { customFields = data.customFields; renderCustomFieldsList(); }
    if (data.customSectionTitle) { var el = document.getElementById('custom-section-title'); if (el) el.value = data.customSectionTitle; }
    if (data.hiddenFields) { hiddenFields = data.hiddenFields; }
    if (data.hiddenSections) {
      // Merge: keep default hidden state for multipage sections if not in saved data
      hiddenSections = Object.assign({
        aboutme: true, preferences: true, paternal: true, maternal: true,
        photopage: true, horoscope: true, hobbies: true, custom: true
      }, data.hiddenSections);
    }
    if (data.customize) {
      customize = Object.assign(customize, data.customize);
      // Migrate old Unicode icon values to new id-based system
      var iconMigration = {
        '\u0950': 'hinduism', '\u271D': 'christianity', '\u2720': 'christianity',
        '\u262A': 'islam', '\u262C': 'sikhism', '\u2638': 'none',
        '\u2721': 'none', '\u2625': 'none', '\u262F': 'none', '\u2605': 'none',
        '\u2767': 'none', '\u26E9': 'none', '\uFD3F': 'islam', '': 'none'
      };
      if (customize.icon && iconMigration.hasOwnProperty(customize.icon)) {
        customize.icon = iconMigration[customize.icon];
      }
      // If icon id doesn't match any option, default to hinduism
      if (!iconOptions.find(function(ic) { return ic.id === customize.icon; })) {
        customize.icon = 'hinduism';
      }
    }
    if (data.photoData) {
      photoData = data.photoData;
      document.getElementById('photo-preview').innerHTML = '<img src="' + photoData + '" alt="Profile photo">';
    }
  } catch(e) {}
}

// INIT
loadAutoSave();
checkExistingPayment();
init();

// Fonts change text metrics: re-measure pagination once webfonts finish loading,
// otherwise sections measured with fallback fonts can land across page boundaries.
if (document.fonts && document.fonts.ready) {
  document.fonts.ready.then(function() {
    updatePreview();
  });
}
