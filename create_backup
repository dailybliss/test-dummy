}

function renderPaternalFamilyFields(ac, bgMid) {
  if (hiddenSections.paternal) return '';
  var has = formData.paternalGrandfather || formData.paternalGrandmother || formData.paternalNative || fatherSiblings.length;
  if (!has) return '';
  var html = '<div class="pv-section"' + (window._sectionStyle||'') + '>' + renderSectionTitle('Paternal family', ac, bgMid);
  if (formData.paternalGrandfather) {
    var pgVal = formData.paternalGrandfather + (formData.paternalGrandfatherOcc ? ' — ' + formData.paternalGrandfatherOcc : '');
    html += renderFieldRow('Paternal grandfather', pgVal, ac, bgMid);
  }
  if (formData.paternalGrandmother) html += renderFieldRow('Paternal grandmother', formData.paternalGrandmother, ac, bgMid);
  if (formData.paternalNative) html += renderFieldRow('Native place', formData.paternalNative, ac, bgMid);
  fatherSiblings.forEach(function(s) {
    if (s.name || s.relation) {
      var val = (s.relation || '') + (s.name ? (s.relation ? ' ' : '') + s.name : '');
      if (!s.hideOccupation && s.occupation) val += ' — ' + s.occupation;
      if (!s.hideLocation && s.location) val += ', ' + s.location;
