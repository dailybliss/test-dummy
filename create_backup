function handleImport(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(ev) {
    try {
      var data = JSON.parse(ev.target.result);
      if (data.formData) {
        formData = data.formData;
        Object.keys(formData).forEach(function(key) {
          var input = document.querySelector('.field-input[data-field="' + key + '"]');
          if (input) input.value = formData[key] || '';
        });
      }
      if (data.siblings) { siblings = data.siblings; renderSiblings(); }
      if (data.hiddenFields) {
        hiddenFields = data.hiddenFields;
        Object.keys(hiddenFields).forEach(function(f) {
          var btn = document.querySelector('.field-hide-btn[data-field="' + f + '"]');
          if (btn && hiddenFields[f]) { btn.textContent = 'Show'; btn.classList.add('hidden-field'); }
        });
      }
      if (data.hiddenSections) { hiddenSections = data.hiddenSections; }
      if (data.customize) {
        customize = Object.assign(customize, data.customize);
        var iconMig = {
          '\u0950': 'hinduism', '\u271D': 'christianity', '\u2720': 'christianity',
          '\u262A': 'islam', '\u262C': 'sikhism', '\u2638': 'none',
          '\u2721': 'none', '\u2625': 'none', '\u262F': 'none', '\u2605': 'none',
          '\u2767': 'none', '\u26E9': 'none', '\uFD3F': 'islam', '': 'none'
        };
        if (customize.icon && iconMig.hasOwnProperty(customize.icon)) {
          customize.icon = iconMig[customize.icon];
        }
        if (!iconOptions.find(function(ic) { return ic.id === customize.icon; })) {
          customize.icon = 'hinduism';
        }
        renderColorPresets();
        renderFontSelect();
        renderIconSelect();
      }
      updatePreview();
      alert('Data imported successfully!');
    } catch(err) {
      alert('Invalid file format. Please select a valid biodata JSON file.');
    }
  };
  reader.readAsText(file);
  e.target.value = '';
}

