      '<div style="font-size:13px;color:#888">Please wait</div>' +
    '</div>';
  document.body.appendChild(verifyOverlay);

  function removeVerifyOverlay() {
    var el = document.getElementById('payment-verifying');
    if (el) el.parentNode.removeChild(el);
  }

  fetch(WORKER_URL + '/verify-payment', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({
      razorpay_order_id: response.razorpay_order_id,
      razorpay_payment_id: response.razorpay_payment_id,
      razorpay_signature: response.razorpay_signature
    })
  })
  .then(function(res) { return res.json(); })
  .then(function(data) {
    removeVerifyOverlay();
    if (data.success) {
      paymentDone = true;
      onPaymentSuccess();
    } else {
      showPaymentResult(false, 'Payment verification failed. Please contact support with Payment ID: ' + response.razorpay_payment_id);
    }
  })
  .catch(function(err) {
    removeVerifyOverlay();
    // Do NOT fall back to success on network error — show error instead
    showPaymentResult(false, 'Could not verify payment. Please contact support with Payment ID: ' + (response.razorpay_payment_id || 'unknown'));
  });
}

