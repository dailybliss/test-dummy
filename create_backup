// ===== READ FORM =====
function readForm() {
  document.querySelectorAll('.field-input[data-field]').forEach(function(input) {
    // Never let readForm overwrite income when range mode is active —
    // incomeRangeValue is the source of truth in that case.
    if (input.dataset.field === 'income' && incomeRangeActive) return;
    formData[input.dataset.field] = input.value;
  });
  // When range is active, always use incomeRangeValue
  if (incomeRangeActive) formData.income = incomeRangeValue;
}

// ===== PREVIEW RENDERING =====
var _previewDebounce = null;
var _previewRendering = false;
var _previewQueued = false;

function updatePreview() {
  readForm();
  autoSave();
  // Debounce the real-file render so we don't run html2canvas on every keystroke
  scheduleRealPreview();
}

function scheduleRealPreview() {
  if (_previewDebounce) clearTimeout(_previewDebounce);
  showPreviewLoading();
  _previewDebounce = setTimeout(function() {
    renderRealPreview();
  }, 900);
}

function showPreviewLoading() {
  var indicator = document.getElementById('page-indicator');
  if (indicator) indicator.textContent = 'Updating…';
}

// Render the ACTUAL file (same canvases used for download) into the preview panel
function renderRealPreview() {
  if (_previewRendering) { _previewQueued = true; return; }
  _previewRendering = true;

  renderAllPages(function(pageCanvases) {
    displayPreviewCanvases(pageCanvases);
    _previewRendering = false;
    updatePageIndicator(pageCanvases.length);
    if (_previewQueued) {
      _previewQueued = false;
      renderRealPreview();
    }
  }, true); // quiet = true (no big overlay)
}

function displayPreviewCanvases(pageCanvases) {
  renderCanvasesInto('preview-pages', pageCanvases);
  renderCanvasesInto('mobile-preview-pages', pageCanvases);
}

function renderCanvasesInto(containerId, pageCanvases) {
  var container = document.getElementById(containerId);
  if (!container) return;
  container.innerHTML = '';

  pageCanvases.forEach(function(canvas, idx) {
    var wrap = document.createElement('div');
    wrap.className = 'preview-page-wrap';

    if (pageCanvases.length > 1 && idx > 0) {
      var label = document.createElement('div');
      label.className = 'preview-page-label';
      label.textContent = '— Page ' + (idx + 1) + ' —';
      wrap.appendChild(label);
    }

    var frame = document.createElement('div');
    frame.className = 'preview-frame';

    // Draw the real canvas as an image that fills the frame
    var img = document.createElement('img');
    img.src = canvas.toDataURL('image/png');
    img.style.cssText = 'width:100%;height:100%;object-fit:contain;display:block';
    frame.appendChild(img);

    // PREVIEW watermark overlay
    var wm = document.createElement('div');
    wm.className = 'preview-watermark-overlay';
    frame.appendChild(wm);

    wrap.appendChild(frame);
    container.appendChild(wrap);
  });
}

function updatePageIndicator(totalCanvases) {
  var indicator = document.getElementById('page-indicator');
  if (indicator) {
    var count = totalCanvases || currentPageCount;
    indicator.textContent = count === 1 ? 'Single page' : count + ' pages';
  }
}

// Build content windowed to a specific page
function buildPagedPreviewHTML(pageNum, includeWatermark) {
  var contentHTML = paginatedCache.html || buildPreviewHTML(false, true);
  var pageHeight = 842;
  var naturalHeight = paginatedCache.naturalHeight || pageHeight;
  var totalHeight = currentPageCount * pageHeight;
  var offset = (pageNum - 1) * pageHeight;

  var html = '<div class="paged-content-wrap" style="position:absolute;top:0;left:0;width:595px;height:842px;overflow:hidden;">';

  if (maxPages === 1 && naturalHeight > pageHeight) {
    // Single page mode: scale all content down to fit one page — no clipping, no joins
    var fitScale = (pageHeight / naturalHeight) * 0.99;
    var scaledWidth = 595 * fitScale;
    var xOffset = (595 - scaledWidth) / 2;
    html += '<div style="position:absolute;top:0;left:0;width:595px;height:' + naturalHeight + 'px;';
    html += 'transform:translateX(' + xOffset + 'px) scale(' + fitScale + ');transform-origin:top left;">';
    html += contentHTML;
    html += '</div>';
  } else {
    // Multi-page mode: clip to this page's slice
    html += '<div style="position:absolute;top:0;left:0;width:595px;height:' + pageHeight + 'px;overflow:hidden;">';
    html += '<div style="position:absolute;top:' + (-offset) + 'px;left:0;width:595px;height:' + totalHeight + 'px;">';
    html += contentHTML;
    html += '</div>';
    html += '</div>';
  }

  if (includeWatermark) {
    var ac = customize.accentColor;
    html += '<svg style="position:absolute;inset:0;z-index:10;pointer-events:none;" viewBox="0 0 595 842" xmlns="http://www.w3.org/2000/svg">';
    html += '<defs><pattern id="wmp' + pageNum + '" x="0" y="0" width="260" height="140" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">';
    html += '<text x="10" y="35" font-family="Inter,sans-serif" font-size="16" fill="' + ac + '" opacity="0.1" font-weight="700" letter-spacing="3">PREVIEW</text>';
    html += '</pattern></defs><rect width="595" height="842" fill="url(#wmp' + pageNum + ')"/></svg>';
  }

  html += '</div>';
  return html;
}

function buildPreviewHTML(includeWatermark, forExport, fitScale) {
  if (includeWatermark === undefined) includeWatermark = true;
  var ac = customize.accentColor;
  var df = customize.displayFont;
  var bgLight = hexToLight(ac);
  var bgMid = hexToMid(ac);
  var goldColor = adjustBrightness(ac, 40);
  var name = formData.fullName || 'Your Name';

  // Font sizes: preview uses tiny clamp values for the small panel,
  // export uses proper A4 document sizes (595px = 210mm A4 width)
  var cursiveFonts = ['Dancing Script'];
  var isCursive = cursiveFonts.indexOf(customize.displayFont) >= 0;

  var sz = forExport ? {
    icon: '22px',
    name: isCursive ? '48px' : '34px',
    tagline: '12px',
    secTitle: isCursive ? '23px' : '16px',
    field: '14.5px',
    fieldLabel: '13px',
    pref: '14.5px'
  } : {
    icon: 'clamp(8px,2.5%,14px)',
    name: isCursive ? 'clamp(16px,6%,32px)' : 'clamp(10px,4.5%,22px)',
    tagline: 'clamp(5px,1.5%,8px)',
    secTitle: isCursive ? 'clamp(9px,3.2%,16px)' : 'clamp(5px,2%,10px)',
    field: 'clamp(5px,1.8%,9px)',
    fieldLabel: 'clamp(4px,1.5%,8px)',
    pref: 'clamp(5px,1.8%,9px)'
  };

  // Store for helper functions
  window._sz = sz;
  window._forExport = forExport;

  // Photo width: slightly larger so the image is clearly visible
  var photoW = customize.photoSize === 'small' ? '28%' : customize.photoSize === 'large' ? '40%' : '34%';
  // Photo shape determines both border-radius and aspect ratio:
  //  - circle: 1:1 square with full rounding
  //  - oval: taller ellipse
  //  - rounded: portrait rectangle with soft corners
  var photoShape = customize.photoShape;

  var contentPadding = forExport ? '32px 40px 28px' : '5% 6% 4%';
  var sectionStyle = forExport ? ' style="margin-bottom:14px"' : '';
  window._sectionStyle = sectionStyle;

  // For export/paged rendering, background fills the full (possibly multi-page) height
  // and content flows naturally. For the small live preview (non-export) it fills the box.
  // When fitScale is provided (single-page "fit to one page" mode), the OUTER wrapper
  // the caller provides is fixed at exactly one page (842px) tall — so height:100% here
  // resolves to one natural page, and the background is never stretched or re-tiled.
  // Only the .pv-content text gets the scale transform, exactly like the PDF export.
  var bgStyle, contentHeightStyle;
  if (forExport) {
    bgStyle = 'position:absolute;top:0;left:0;width:100%;height:100%;min-height:842px;';
    contentHeightStyle = 'min-height:842px;';
  } else {
    bgStyle = 'position:absolute;inset:0;';
    contentHeightStyle = 'height:100%;';
  }

  var bgImgSrc = currentTemplate.bgImage || null;
  var bgInlineStyle;
  if (bgImgSrc) {
    if (fitScale || maxPages === 1) {
      // Single page: stretch ONE image to cover the entire content box (whatever
      // its natural height), no tiling — so there is never a seam line.
      bgInlineStyle = bgStyle + 'background-image:url(' + bgImgSrc + ');background-size:100% 100%;background-repeat:no-repeat;background-color:transparent;';
    } else {
      // Multi-page: one image per printed page, tiled at page-height intervals.
      bgInlineStyle = bgStyle + 'background-image:url(' + bgImgSrc + ');background-size:100% 842px;background-repeat:repeat-y;background-color:transparent;';
    }
  } else {
    bgInlineStyle = bgStyle + 'background:' + bgLight + ';border:1px solid ' + bgMid + ';';
  }
  var html = '<div class="pv-bg" style="' + bgInlineStyle + '"></div>';

  // Scale transform for single-page fit mode — applied ONLY to the content,
  // never to the background, so the template art is never stretched or cropped.
  var contentTransform = '';
  if (fitScale) {
    var scaledWidth = 595 * fitScale;
    var xOffset = (595 - scaledWidth) / 2;
    contentTransform = 'transform:translateX(' + xOffset + 'px) scale(' + fitScale + ');transform-origin:top left;';
  }
  html += '<div class="pv-content" style="' + contentHeightStyle + 'color:' + darken(ac, 0.15) + ';padding:' + contentPadding + ';font-family:\'Lato\',sans-serif;' + contentTransform + '">';

  // Header
  html += '<div class="pv-header">';
  if (customize.icon) {
    var iconDef = iconOptions.find(function(ic) { return ic.id === customize.icon; });
    if (iconDef && iconDef.svg) {
      var iconPx = forExport ? 36 : parseInt(sz.icon) || 28;
      var vbMatch = iconDef.svg.match(/viewBox="([\d.\s]+)"/);
      var vbW = 100, vbH = 100;
      if (vbMatch) {
        var vb = vbMatch[1].split(/\s+/).map(parseFloat);
        vbW = vb[2]; vbH = vb[3];
      }
      var iconH = Math.round(iconPx * vbH / vbW);
      var coloredSvg = iconDef.svg.replace(/fill="currentColor"/g, 'fill="' + ac + '"');
      // Ensure xmlns exists (don't duplicate if already present)
      if (coloredSvg.indexOf('xmlns=') === -1) {
        coloredSvg = coloredSvg.replace('<svg ', '<svg xmlns="http://www.w3.org/2000/svg" ');
      }
      // Add explicit width/height if not present
      if (!/\<svg[^>]*\swidth=/.test(coloredSvg)) {
        coloredSvg = coloredSvg.replace('<svg ', '<svg width="' + iconPx + '" height="' + iconH + '" ');
      }
      var dataUrl = 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(coloredSvg);
      html += '<div class="pv-icon" style="text-align:center"><img src="' + dataUrl + '" width="' + iconPx + '" height="' + iconH + '" style="width:' + iconPx + 'px;height:' + iconH + 'px;display:inline-block"></div>';
    }
  }
  html += '<div class="pv-name" style="font-family:\'' + df + '\',serif;font-size:' + sz.name + ';color:' + ac + '">' + name + '</div>';
  html += '</div>';

  // Divider — gradient looks nicer in preview, but html2canvas renders gradients
  // via createPattern which fails on mobile. Use a solid line for export.
  if (forExport) {
    html += '<div class="pv-divider" style="background:' + goldColor + ';opacity:0.55"></div>';
  } else {
    html += '<div class="pv-divider" style="background:linear-gradient(to right,transparent,' + goldColor + ',transparent)"></div>';
  }

  // Body layout
  var photoOnRight = customize.photoPosition === 'right';
  var photoOnCenter = customize.photoPosition === 'center';

  if (photoOnCenter) {
    html += renderPhoto(ac, bgMid, photoW, photoShape, 'margin:0 auto 3%');
    html += '<div class="pv-details">';
    html += renderAboutMeFields(ac, bgMid);
    html += renderPersonalFields(ac, bgMid);
    html += renderEducationFields(ac, bgMid);
    html += renderFamilyFields(ac, bgMid);
    html += renderPaternalFamilyFields(ac, bgMid);
    html += renderMaternalFamilyFields(ac, bgMid);
    if (!hiddenSections.horoscope) html += renderHoroscopeFields(ac, bgMid);
    html += renderHobbiesFields(ac, bgMid);
    html += renderCustomSection(ac, bgMid);
    if (!hiddenSections.preferences) html += renderPreferencesFields(ac, bgMid);
    html += renderContactFields(ac, bgMid);
    html += '</div>';
  } else {
    html += '<div class="pv-body" style="flex-direction:' + (photoOnRight ? 'row-reverse' : 'row') + ';align-items:flex-start">';
    html += renderPhoto(ac, bgMid, photoW, photoShape, '');
    html += '<div class="pv-details">';
    html += renderAboutMeFields(ac, bgMid);
    html += renderPersonalFields(ac, bgMid);
    html += renderEducationFields(ac, bgMid);
    html += renderFamilyFields(ac, bgMid);
    html += renderPaternalFamilyFields(ac, bgMid);
    html += renderMaternalFamilyFields(ac, bgMid);
    if (!hiddenSections.horoscope) html += renderHoroscopeFields(ac, bgMid);
    html += renderHobbiesFields(ac, bgMid);
    html += renderCustomSection(ac, bgMid);
    if (!hiddenSections.preferences) html += renderPreferencesFields(ac, bgMid);
    html += renderContactFields(ac, bgMid);
    html += '</div>';
    html += '</div>';
  }

  html += '</div>';

  // Watermark (skip for final PDF/image render)
  if (includeWatermark) {
    html += '<svg class="pv-watermark" viewBox="0 0 595 842" xmlns="http://www.w3.org/2000/svg">';
    html += '<defs><pattern id="wm" x="0" y="0" width="260" height="140" patternUnits="userSpaceOnUse" patternTransform="rotate(-30)">';
    html += '<text x="10" y="35" font-family="Inter,sans-serif" font-size="16" fill="' + ac + '" opacity="0.08" font-weight="700" letter-spacing="3">PREVIEW</text>';
    html += '</pattern></defs><rect width="595" height="842" fill="url(#wm)"/></svg>';
  }

  return html;
}

function renderPhoto(ac, bgMid, width, shape, extra) {
  // Shape → aspect ratio + border-radius.
  // rounded  = rounded square (1:1)
  // circle   = circle (1:1, full radius)
  // oval     = vertical ellipse
  // rectangle= tall vertical rectangle (~3x the rounded-square height), left/right only
  var aspect, radius;
  if (shape === 'circle') {
    aspect = '1 / 1';
    radius = '50%';
  } else if (shape === 'oval') {
    aspect = '3 / 3.5';
    radius = '50%';
  } else if (shape === 'rectangle') {
    aspect = '3 / 4';
    radius = '10px';
  } else {
    // rounded square
    aspect = '1 / 1';
    radius = '12px';
  }
  var html = '<div class="pv-photo" style="width:' + width + ';aspect-ratio:' + aspect + ';background:' + hexToLight(ac) + ';border:1px solid ' + bgMid + ';border-radius:' + radius + ';overflow:hidden;' + extra + '">';
  if (photoData) {
    html += '<img src="' + photoData + '" style="width:100%;height:100%;object-fit:cover;border-radius:' + radius + '">';
  } else {
    html += '<svg viewBox="0 0 24 24" fill="none" stroke="' + bgMid + '" stroke-width="1.5" style="width:36%"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-7 8-7s8 3 8 7"/></svg>';
  }
  html += '</div>';
  return html;
}

// Aspect ratio (height/width) per shape — used for html2canvas height fix
function photoRatioForShape(shape) {
  if (shape === 'circle') return 1;
  if (shape === 'oval') return 3.5/3;
  if (shape === 'rectangle') return 4/3;
  return 1; // rounded square
}

// ===== EXTRA PHOTOS (Photo Page) =====
var extraPhotos = [null, null, null, null]; // up to 4 photo data URLs

function handleExtraPhoto(input) {
  var slot = parseInt(input.getAttribute('data-slot'));
  var file = input.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(e) {
    extraPhotos[slot] = e.target.result;
    var preview = document.getElementById('extra-photo-preview-' + slot);
    preview.innerHTML = '<img src="' + e.target.result + '" style="width:100%;height:100%;object-fit:cover">';
    // Show remove button
    var removeBtn = input.nextElementSibling.nextElementSibling;
    if (removeBtn) removeBtn.style.display = 'block';
    scheduleRealPreview();
  };
  reader.readAsDataURL(file);
}

function removeExtraPhoto(slot) {
  extraPhotos[slot] = null;
  var preview = document.getElementById('extra-photo-preview-' + slot);
  preview.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg><span>Add photo</span>';
  var slot_el = document.querySelector('[data-slot="' + slot + '"]');
  if (slot_el) {
    var removeBtn = slot_el.querySelector('.extra-photo-remove');
    if (removeBtn) removeBtn.style.display = 'none';
  }
  scheduleRealPreview();
}

function buildPhotoPageHTML(ac, bgMid) {
  if (hiddenSections.photopage) return '';
  var activePhotos = extraPhotos.filter(function(p) { return p !== null; });
  if (!activePhotos.length) return '';

  var bgImgSrc = currentTemplate.bgImage || null;
  var bgStyle = bgImgSrc
    ? 'background-image:url(' + bgImgSrc + ');background-size:100% 842px;background-repeat:no-repeat;background-color:transparent;'
    : 'background:' + hexToLight(ac) + ';';

  var html = '<div style="position:relative;width:595px;height:842px;">';
  html += '<div style="position:absolute;inset:0;' + bgStyle + '"></div>';

  // Photo grid centred in the full page — equal margins on all 4 edges
  var count = activePhotos.length;
  var photoW = count === 1 ? '420px' : '268px';
  var photoH = count === 1 ? '560px' : '356px';

  html += '<div style="position:relative;z-index:1;width:100%;height:100%;display:flex;align-items:center;justify-content:center;box-sizing:border-box;">';
  html += '<div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:center;align-content:center;">';
  activePhotos.forEach(function(src) {
    html += '<div style="width:' + photoW + ';height:' + photoH + ';overflow:hidden;">';
    html += '<img src="' + src + '" style="width:100%;height:100%;object-fit:cover">';
    html += '</div>';
  });
  html += '</div>';
  html += '</div></div>';
  return html;
}

function toggleIncomeRange(cb) {
  incomeRangeActive = cb.checked;
  document.getElementById('income-exact').style.display = incomeRangeActive ? 'none' : 'block';
  document.getElementById('income-range').style.display = incomeRangeActive ? 'block' : 'none';
  if (!incomeRangeActive) {
    // Switching back to exact — restore the text input value
    incomeRangeValue = '';
    var exactInput = document.querySelector('[data-field="income"]');
    if (exactInput) formData.income = exactInput.value;
  } else {
    updateIncomeRange();
  }
}

function updateIncomeRange() {
  var from = document.getElementById('income-from');
