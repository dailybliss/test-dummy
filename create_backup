function initiatePayment() {
  closePayment();

  // Show loading state
  var loadingOverlay = document.createElement('div');
  loadingOverlay.id = 'payment-loading';
  loadingOverlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;align-items:center;justify-content:center;font-family:Inter,sans-serif';
  loadingOverlay.innerHTML =
    '<div style="background:#fff;border-radius:16px;padding:32px;max-width:300px;width:90%;text-align:center;box-shadow:0 20px 60px rgba(0,0,0,0.3)">' +
      '<div style="font-size:28px;margin-bottom:12px">💳</div>' +
      '<div style="font-size:15px;font-weight:600;color:#1a1a1a;margin-bottom:6px">Preparing payment...</div>' +
      '<div style="font-size:13px;color:#888">Please wait</div>' +
    '</div>';
  document.body.appendChild(loadingOverlay);

  // Step 1: Create order via Cloudflare Worker
  fetch(WORKER_URL + '/create-order', {
    method: 'POST',
    headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ amount: PAYMENT_AMOUNT })
  })
  .then(function(res) { return res.json().then(function(data) { return { status: res.status, data: data }; }); })
  .then(function(result) {
    document.body.removeChild(loadingOverlay);
    console.log('Worker response:', result.status, result.data);

    if (!result.data.order_id) {
      alert('Could not initiate payment. Error: ' + (result.data.error || result.data.detail || JSON.stringify(result.data)) + '\n\nPlease try again or contact support.');
      return;
    }

    // Guard: ensure only ONE outcome is processed per checkout session
    var paymentOutcomeHandled = false;

    // Step 2: Open Razorpay checkout with the order
    var options = {
      key: RAZORPAY_KEY_ID,
      amount: result.data.amount,
      currency: result.data.currency,
      order_id: result.data.order_id,
      name: 'Marriage Biodata Maker',
      description: 'Biodata Download — PDF & Image',
      theme: { color: '#8B1A3A' },
      prefill: {
        name: formData.fullName || '',
        email: formData.email || '',
        contact: formData.phone || ''
      },
      handler: function(response) {
        // Success handler — only fires when Razorpay confirms payment captured.
        // Verify signature server-side before unlocking download.
        if (paymentOutcomeHandled) return;
        paymentOutcomeHandled = true;
        verifyAndActivate(response);
      },
      modal: {
        ondismiss: function() {
          // User closed checkout — reset so they can retry
          paymentOutcomeHandled = false;
        }
      }
    };

    try {
      var rzp = new Razorpay(options);
      rzp.on('payment.failed', function(response) {
        // Failure event — do NOT set paymentOutcomeHandled permanently,
        // because Razorpay allows retry in the same modal. Just show a toast.
        // Only show failure if the modal is actually closing (no retry).
        paymentDone = false;
        var reason = response.error ? (response.error.description || response.error.reason || 'Payment failed') : 'Payment failed';
        // Show a non-blocking inline message; user can still retry in the open modal
        console.log('Payment attempt failed:', reason);
      });
      rzp.open();
    } catch(e) {
      alert('Payment gateway could not load. Please disable any ad blockers and try again.');
    }
  })
  .catch(function() {
    if (document.getElementById('payment-loading')) {
      document.body.removeChild(loadingOverlay);
    }
    alert('Network error. Please check your connection and try again.');
  });
}

function verifyAndActivate(response) {
  // Show verifying state
  var verifyOverlay = document.createElement('div');
  verifyOverlay.id = 'payment-verifying';
  verifyOverlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.6);z-index:9999;display:flex;align-items:center;justify-content:center;font-family:Inter,sans-serif';
  verifyOverlay.innerHTML =
