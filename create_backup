// ===== INIT =====
function init() {
  renderColorPresets();
  renderFontSelect();
  renderIconSelect();
  renderTemplateSwitcher();
  syncSinglePageToggle();
  syncSectionToggles();
  updateRectangleAvailability();
  renderFatherSiblingsList();
  renderMotherSiblingsList();
  renderCustomFieldsList();
  updateDownloadButtons();
  readForm();
  checkPaymentRedirect();
  renderRealPreview();
}

function syncSectionToggles() {
  document.querySelectorAll('.section-toggle[data-section]').forEach(function(btn) {
    var sec = btn.getAttribute('data-section');
    var isHidden = hiddenSections[sec];
    if (isHidden) {
      btn.classList.remove('on');
    } else {
      btn.classList.add('on');
    }
  });
}

// Sections that are only available in multi-page mode
var MULTIPAGE_ONLY_SECTIONS = ['sec-aboutme', 'sec-preferences', 'sec-paternal', 'sec-maternal', 'sec-photopage', 'sec-horoscope', 'sec-hobbies', 'sec-custom'];

function applyMultipageRestrictions() {
  var isSingle = maxPages === 1;
  MULTIPAGE_ONLY_SECTIONS.forEach(function(id) {
    var card = document.getElementById(id);
    if (!card) return;
    if (isSingle) {
      card.classList.add('multipage-only-locked');
      // Force these sections hidden in the biodata when single page
      var sec = card.querySelector('.section-toggle');
      if (sec) {
        var sectionName = sec.getAttribute('data-section');
        if (sectionName) hiddenSections[sectionName] = true;
      }
    } else {
      card.classList.remove('multipage-only-locked');
      // Restore section visibility based on toggle state
      var sec = card.querySelector('.section-toggle');
      if (sec) {
        var sectionName = sec.getAttribute('data-section');
        if (sectionName) hiddenSections[sectionName] = !sec.classList.contains('on');
      }
    }
  });
}

function toggleSinglePage(btn) {
  var isOn = btn.classList.contains('on');
  if (isOn) {
    btn.classList.remove('on');
    maxPages = currentTemplate.singlePage ? 1 : 3;
  } else {
    btn.classList.add('on');
    maxPages = 1;
  }
  paginatedCache = { html: '', pageCount: 1 };
  applyMultipageRestrictions();
  updatePreview();
}

function syncSinglePageToggle() {
  var btn = document.getElementById('single-page-toggle');
  if (!btn) return;
  if (maxPages === 1) {
    btn.classList.add('on');
  } else {
    btn.classList.remove('on');
  }
  applyMultipageRestrictions();
}

function renderTemplateSwitcher() {
  var el = document.getElementById('template-switcher');
  if (!el) return;
  el.innerHTML = '';
  Object.keys(TEMPLATES).forEach(function(id) {
    var tmpl = TEMPLATES[id];
    var btn = document.createElement('button');
    btn.className = 'template-thumb-btn' + (id === currentTemplateId ? ' active' : '');
    if (tmpl.bgImage) {
      btn.style.backgroundImage = 'url(' + tmpl.bgImage + ')';
    } else {
      btn.style.background = '#F5F0EA';
    }
    // Label
    var label = document.createElement('div');
    label.className = 'template-thumb-label';
    // Convert id to readable name: 'kalash-ornate' → 'Kalash'
    label.textContent = id.split('-')[0].charAt(0).toUpperCase() + id.split('-')[0].slice(1);
    btn.appendChild(label);
    // Price badge
    var price = document.createElement('div');
    price.style.cssText = 'position:absolute;top:4px;right:4px;font-size:8px;font-weight:700;padding:2px 5px;border-radius:4px;';
    if (tmpl.free) {
      price.style.background = 'rgba(39,174,96,0.9)';
      price.style.color = '#fff';
      price.textContent = 'FREE';
    } else {
      price.style.background = 'rgba(139,26,58,0.85)';
      price.style.color = '#fff';
      price.textContent = '₹99';
    }
    btn.appendChild(price);
    btn.onclick = function() { switchTemplate(id); };
    btn.title = id.replace(/-/g, ' ').replace(/\b\w/g, function(c){ return c.toUpperCase(); });
    el.appendChild(btn);
  });
}

function switchTemplate(id) {
  if (!TEMPLATES[id]) return;
  currentTemplateId = id;
  currentTemplate = TEMPLATES[id];
  maxPages = currentTemplate.singlePage ? 1 : 3;
  // Invalidate cached paginated content
  paginatedCache = { html: '', pageCount: 1 };
  // Update URL param without reloading
  var url = new URL(window.location.href);
  url.searchParams.set('template', id);
  window.history.replaceState({}, '', url.toString());
  // Re-render switcher to update active state
  renderTemplateSwitcher();
  syncSinglePageToggle();
  updateDownloadButtons();
  updatePreview();
}

function renderColorPresets() {
  var el = document.getElementById('color-presets');
  el.innerHTML = '';
  colorOptions.forEach(function(c) {
    var swatch = document.createElement('div');
    swatch.className = 'color-swatch' + (c.hex === customize.accentColor ? ' active' : '');
    swatch.style.background = c.hex;
    swatch.title = c.name;
    swatch.onclick = function() {
      customize.accentColor = c.hex;
      renderColorPresets();
      updatePreview();
    };
    el.appendChild(swatch);
  });
}

function renderFontSelect() {
  var el = document.getElementById('font-select');
  el.innerHTML = '';
  fontOptions.forEach(function(f) {
    var btn = document.createElement('button');
    btn.className = 'font-btn' + (f.name === customize.displayFont ? ' active' : '');
    btn.style.fontFamily = f.name;
    btn.style.fontSize = f.cursive ? '17px' : '13px';
    btn.textContent = f.label;
    btn.title = f.name;
    btn.onclick = function() {
      customize.displayFont = f.name;
      renderFontSelect();
      updatePreview();
    };
    el.appendChild(btn);
  });
}

function renderIconSelect() {
  var el = document.getElementById('icon-select-top');
  el.innerHTML = '';
  iconOptions.forEach(function(ic) {
    var btn = document.createElement('button');
    btn.className = 'icon-btn' + (ic.id === customize.icon ? ' active' : '');
    btn.title = ic.label;
    btn.setAttribute('aria-label', ic.label);
    if (ic.svg) {
      btn.innerHTML = ic.svg;
      btn.querySelector('svg').style.cssText = 'width:24px;height:24px;display:block';
    } else {
      btn.textContent = '—';
    }
    btn.onclick = function() {
      customize.icon = ic.id;
      renderIconSelect();
      updatePreview();
    };
    el.appendChild(btn);
  });
}

// ===== FORM INTERACTIONS =====
function toggleCollapse(id) {
  document.getElementById(id).classList.toggle('collapsed');
}

function toggleSection(e, btn) {
  e.stopPropagation();
  btn.classList.toggle('on');
  var sec = btn.dataset.section;
  hiddenSections[sec] = !btn.classList.contains('on');
  updatePreview();
}

function toggleField(btn) {
  var field = btn.dataset.field;
  hiddenFields[field] = !hiddenFields[field];
  btn.textContent = hiddenFields[field] ? 'Show' : 'Hide';
  btn.classList.toggle('hidden-field', hiddenFields[field]);
  updatePreview();
}

function setPhotoOpt(type, value, btn) {
  customize['photo' + type.charAt(0).toUpperCase() + type.slice(1)] = value;
  var row = btn.parentElement;
  row.querySelectorAll('.photo-opt-btn').forEach(function(b) { b.classList.remove('active'); });
  btn.classList.add('active');

  // Rectangle shape is only valid for left/right positions.
  // If user picks center while rectangle is selected, fall back to rounded.
  if (type === 'position' && value === 'center' && customize.photoShape === 'rectangle') {
    customize.photoShape = 'rounded';
    syncShapeButtons();
  }
  // If user picks rectangle while position is center, switch position to left.
  if (type === 'shape' && value === 'rectangle' && customize.photoPosition === 'center') {
    customize.photoPosition = 'left';
    syncPositionButtons();
  }
  updateRectangleAvailability();
  updatePreview();
}

// Enable/disable the Rectangle button based on current position
function updateRectangleAvailability() {
  var rectBtn = document.getElementById('shape-rectangle-btn');
  if (!rectBtn) return;
  if (customize.photoPosition === 'center') {
    rectBtn.style.opacity = '0.4';
    rectBtn.style.pointerEvents = 'none';
    rectBtn.title = 'Rectangle is available only for left/right positions';
  } else {
    rectBtn.style.opacity = '';
    rectBtn.style.pointerEvents = '';
    rectBtn.title = '';
  }
}

function syncShapeButtons() {
  document.querySelectorAll('.photo-opt-group').forEach(function(group) {
    var label = group.querySelector('label');
    if (label && label.textContent === 'Shape') {
      group.querySelectorAll('.photo-opt-btn').forEach(function(b) {
        var isActive = b.getAttribute('onclick').indexOf("'" + customize.photoShape + "'") >= 0;
        b.classList.toggle('active', isActive);
      });
    }
  });
}

function syncPositionButtons() {
  document.querySelectorAll('.photo-opt-group').forEach(function(group) {
    var label = group.querySelector('label');
    if (label && label.textContent === 'Position') {
      group.querySelectorAll('.photo-opt-btn').forEach(function(b) {
        var isActive = b.getAttribute('onclick').indexOf("'" + customize.photoPosition + "'") >= 0;
        b.classList.toggle('active', isActive);
      });
    }
  });
}

function handlePhotoUpload(e) {
  var file = e.target.files[0];
  if (!file) return;
  var reader = new FileReader();
  reader.onload = function(ev) {
    photoData = ev.target.result;
    var preview = document.getElementById('photo-preview');
    preview.innerHTML = '<img src="' + photoData + '" alt="Profile photo">';
    updatePreview();
  };
  reader.readAsDataURL(file);
}

