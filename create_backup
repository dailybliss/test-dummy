.success-overlay {
  display: none; position: fixed; inset: 0; background: rgba(20,10,5,0.7);
  backdrop-filter: blur(4px); z-index: 200; align-items: center; justify-content: center; padding: 16px;
}
.success-overlay.open { display: flex; }
.success-card {
  background: #fff; border-radius: 16px; max-width: 380px; width: 100%;
  padding: 32px 24px; text-align: center; box-shadow: 0 8px 40px rgba(20,10,5,0.3);
}
.success-check { width: 64px; height: 64px; border-radius: 50%; background: var(--green-bg); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; }
.success-check svg { width: 32px; height: 32px; color: var(--green); }
.success-title { font-family: var(--font-display); font-size: 20px; font-weight: 600; color: var(--text-dark); margin-bottom: 4px; }
.success-subtitle { font-size: 13px; color: var(--text-light); margin-bottom: 24px; }
.success-actions { display: flex; flex-direction: column; gap: 10px; }
.success-btn {
  width: 100%; padding: 12px; border-radius: 12px; font-size: 14px; font-weight: 600;
  font-family: var(--font-body); cursor: pointer; display: flex; align-items: center;
  justify-content: center; gap: 8px; transition: all var(--transition);
}
.success-btn svg { width: 18px; height: 18px; }
.success-btn-download { background: var(--rose); color: #fff; border: none; }
.success-btn-download:hover { background: var(--rose-light); }
.success-btn-export { background: #fff; color: var(--text-mid); border: 1px solid var(--border); }
.success-btn-export:hover { border-color: var(--rose); color: var(--rose); }
.success-close-btn {
  margin-top: 16px;
  background: none;
  border: none;
  font-size: 13px;
  color: var(--text-light);
  cursor: pointer;
  text-decoration: underline;
  font-family: var(--font-body);
}
.success-close-btn:hover { color: var(--text-mid); }
.success-confirm {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: inherit;
}
.success-note { font-size: 11px; color: var(--text-light); margin-top: 16px; line-height: 1.6; }

/* GENERATING OVERLAY */
.generating-overlay {
  display: none; position: fixed; inset: 0; background: rgba(255,253,247,0.95);
  z-index: 250; align-items: center; justify-content: center; flex-direction: column; gap: 16px;
}
.generating-overlay.open { display: flex; }
.spinner { width: 40px; height: 40px; border: 3px solid var(--border); border-top-color: var(--rose); border-radius: 50%; animation: spin 0.8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.generating-text { font-size: 14px; color: var(--text-mid); font-weight: 500; }

/* ===== SITE FOOTER ===== */
.site-footer { background: #fff; color: #5A4A3A; border-top: 1px solid #F0EAE2; padding: 56px 24px 0; }
.site-footer-inner { max-width: 960px; margin: 0 auto; }
.site-footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 40px; padding-bottom: 48px; }
.site-footer-name { font-family: 'Dancing Script', cursive; font-size: 22px; font-weight: 700; background: linear-gradient(90deg, #c0392b, #e67e22, #f1c40f, #27ae60, #2980b9, #8e44ad); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; display: inline-block; margin-bottom: 12px; }
.site-footer-tagline { font-size: 13px; line-height: 1.7; color: #5A4A3A; margin-bottom: 12px; max-width: 280px; }
.site-footer-keywords { font-size: 11px; color: #8A7A6A; line-height: 1.8; }
.site-footer-col-title { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 1.5px; color: #8B1A3A; margin-bottom: 14px; }
.site-footer-links { list-style: none; padding: 0; margin: 0; }
.site-footer-links li { margin-bottom: 9px; }
.site-footer-links a { font-size: 13px; color: #5A4A3A; text-decoration: none; transition: color 0.2s; }
.site-footer-links a:hover { color: #e67e22; }
.site-footer-bottom { border-top: 1px solid #F0EAE2; padding: 20px 0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
.site-footer-copy { font-size: 12px; color: #8A7A6A; }
.site-footer-copy a { color: #5A4A3A; text-decoration: none; }
.site-footer-bottom-links { display: flex; gap: 20px; }
.site-footer-bottom-links a { font-size: 12px; color: #8A7A6A; text-decoration: none; }
.site-footer-bottom-links a:hover { color: #9a7a84; }
@media (max-width: 768px) { .site-footer-grid { grid-template-columns: 1fr 1fr; gap: 28px; } .site-footer-brand { grid-column: 1 / -1; } }
@media (max-width: 480px) { .site-footer-grid { grid-template-columns: 1fr; } .site-footer-bottom { flex-direction: column; align-items: flex-start; } }
</style>
