  if (addBtn) addBtn.style.display = customFields.length >= MAX_CUSTOM_FIELDS ? 'none' : 'flex';
}

function renderCustomSection(ac, bgMid) {
  if (hiddenSections.custom) return '';
  var titleEl = document.getElementById('custom-section-title');
  var title = titleEl ? titleEl.value.trim() : '';
  var hasFields = customFields.some(function(f) { return f.label || f.value; });
